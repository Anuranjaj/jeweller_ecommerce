# Development defaults. Never use DEBUG=True or the development SECRET_KEY in production.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# This checkout integration intentionally accepts Razorpay test keys only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure the same webhook secret in the Razorpay dashboard for /api/payments/webhook/.
RAZORPAY_WEBHOOK_SECRET=

# Production requires DEBUG=False, a unique SECRET_KEY of at least 50 characters,
# explicit ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS, and HTTPS at the Django origin.
# If TLS terminates at a proxy, configure Django's trusted proxy HTTPS setting securely.
# The current project uses SQLite; DATABASE_URL is not currently supported.
